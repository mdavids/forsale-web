{{ define "content" }}
<section class="result {{ if .Info.ForSale }}js-trigger-confetti{{ end }}">
  <div class="card">
    <div class="card-header flex-between">
      <div>
        <h2 class="title">{{ T .Lang "result.for_title" }} <span class="mono">{{ .Info.Unicode }}</span></h2>
        <p class="sub">{{ T .Lang "result.punycode" }} <span class="mono">{{ .Info.Punycode }}</span></p>
      </div>
      <div>
        {{ if .Info.ForSale }}<span class="badge badge-success" title="{{ T .Lang "result.badge.forsale.title" }}">{{ T .Lang "result.badge.forsale" }}</span>{{ else }}<span class="badge badge-neutral" title="{{ T .Lang "result.badge.not.title" }}">{{ T .Lang "result.badge.not" }}</span>{{ end }}
      </div>
    </div>
    <div class="card-body">
      {{ if .Info.ForSale }}
        <!-- geen grid-2 <div class="grid-2"> -->
        <div>
          {{ if .Info.FVal }}<div class="panel"><h3>{{ T .Lang "result.price_title" }}</h3><ul class="list">{{ range .Info.FVal }}<li><span class="price">{{ .FormattedNice }}</span> <span class="muted">({{ .Currency }} {{ .AmountString }})</span></li>{{ end }}</ul><p class="disclaimer">{{ T .Lang "result.price_disclaimer" }}</p></div>{{ end }}
          <br>
          {{ if .Info.FUri }}<div class="panel"><h3>{{ T .Lang "result.contact_title" }}</h3><ul class="list">{{ range .Info.FUri }}<li>{{ if .Valid }}<a href="#" onclick="confirmOpen('{{ .URI }}')" class="link">{{ .URI }}</a><span class="tag">{{ .Scheme }}</span>{{ else }}<span class="muted">{{ .URI }}</span><span class="tag tag-warn">{{ T $.Lang "result.unverifiable" }}</span>{{ if .Note }}<div class="note">{{ .Note }}</div>{{ end }}{{ end }}</li>{{ end }}</ul><p class="disclaimer">{{ T .Lang "result.contact_disclaimer" }}</p></div>{{ end }}
          <br>
          {{ if .Info.FTxt }}<div class="panel"><h3>{{ T .Lang "result.extra_title" }}</h3><ul class="list">{{ range .Info.FTxt }}<li>{{ . }}</li>{{ end }}</ul></div>{{ end }}
          <br>
          {{ if .Info.FCod }}<div class="panel"><h3>{{ T .Lang "result.fcod_title" }}</h3><ul class="list">{{ range .Info.FCod }}<li>{{ if .HasRDAPData }}<a href="#" onclick="confirmOpen('{{ .ForSaleURL }}')" class="link">{{ .ForSaleURL }}</a><br>{{ end }}<span class="mono">{{ .Code }}</span></li>{{ end }}</ul><p class="hint">{{ T .Lang "result.fcod_hint" }}
          <br>{{ T .Lang "result.fcod_hint2" }}</p></div>{{ end }}
        </div>
      {{ else }}
        <div class="empty-state"><h3>{{ T .Lang "result.empty_title" }} <code>_for-sale</code> {{ T .Lang "result.empty_title2" }}</h3><p>{{ T .Lang "result.empty_body" }}<br>{{ T .Lang "result.empty_whois" }}<br>{{ T .Lang "result.empty_visit_pre" }} <a href="#" onclick="confirmOpen('http:\/\/{{ .Info.Unicode }}')" class="link">{{ .Info.Unicode }}</a> {{ T .Lang "result.empty_visit_post" }}</p></div>
      {{ end }}
<!--
      {{ if .Info.Reasons }}<div class="panel"><h3>Analyse</h3><ul class="list">{{ range .Info.Reasons }}<li>{{ . }}</li>{{ end }}</ul></div>{{ end }}
      {{ if .Info.Warnings }}<div class="panel"><h3>Opmerkingen</h3><ul class="list">{{ range .Info.Warnings }}<li>{{ . }}</li>{{ end }}</ul></div>{{ end }}
-->
      {{ if .Info.RawRR }}<details class="raw"><summary>{{ T .Lang "result.raw_summary" }}</summary><pre>{{ range .Info.RawRR }}{{ . }}
{{ end }}</pre></details>{{ end }}
    </div>
  </div>
  <div class="actions"><a class="btn btn-secondary" href="{{ AddLang .Lang "/forsale" }}">{{ T .Lang "result.new_check" }}</a><a class="btn btn-ghost" href="{{ AddLang .Lang (printf "/api/check?domain=%s" .Info.DomainInput) }}" target="_blank" rel="noopener">JSON API</a></div>
</section>
{{ end }}
