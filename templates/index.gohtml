{{ define "content" }}
<section class="hero">
  <div class="hero-card">
    <h1>{{ T .Lang "index.h1" }}</h1>
    <p class="lead">{{ T .Lang "index.lead_pre" }} <strong>{{ .DefaultDemo }}</strong>{{ T .Lang "index.lead_mid" }}
      <code>_for-sale</code> {{ T .Lang "index.lead_post" }}</p>
    <form action="/lookup" method="get" class="form-grid" autocomplete="off" novalidate>
      <input type="hidden" name="lang" value="{{ .Lang }}">
      <label for="domain" class="visually-hidden">{{ T .Lang "index.domain_label" }}</label>
      <input id="domain" name="domain" type="text" class="input-lg" placeholder="{{ .DefaultDemo }}" required autocomplete="off" spellcheck="false" autocapitalize="off" inputmode="url">
      <button class="btn btn-primary btn-lg" type="submit">{{ T .Lang "index.submit" }}</button>
    </form>
    <p class="hint">{{ T .Lang "index.hint" }}</p>
  </div>
</section>
{{ end }}
